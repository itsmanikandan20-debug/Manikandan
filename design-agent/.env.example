# You normally don't need to edit this file.
# The helper window asks for your key the first time and saves it to ".env" for you.

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: force a specific Gemini model. Leave empty to pick the best free "flash" model automatically.
GEMINI_MODEL=

# Optional: change the port the helper window uses.
PORT=3456
